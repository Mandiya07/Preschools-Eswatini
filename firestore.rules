rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function getRole() {
      return (isSignedIn() && 'email' in request.auth.token && request.auth.token.email == 'siphom.yati@gmail.com') ? 'SuperAdmin' :
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data ?
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null);
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'siphom.yati@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SuperAdmin')
      );
    }

    function isSchoolOwner(schoolId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (schoolId is string && (
          (exists(/databases/$(database)/documents/schools/$(schoolId)) && 
           'ownerId' in get(/databases/$(database)/documents/schools/$(schoolId)).data &&
           get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SchoolAdmin' &&
           'schoolId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId)
        ))
      );
    }

    // --- Entity Specific Validators ---
    
    function isValidStudent(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.class is string && data.class.size() <= 50;
    }

    function isValidStaff(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 100;
    }

    function isValidAttendance(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.status in ['Present', 'Absent', 'Late', 'Excused'];
    }

    function isValidEvent(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidAnnouncement(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000;
    }

    function isValidSchool(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.region is string && data.region.size() <= 50 &&
             data.town is string && data.town.size() <= 50 &&
             data.ownerId == request.auth.uid &&
             (data.description == null || (data.description is string && data.description.size() <= 5000));
    }

    function isValidInquiry(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.parentName is string && data.parentName.size() <= 100 &&
             data.parentEmail is string && data.parentEmail.size() <= 100 &&
             data.message is string && data.message.size() <= 1000 &&
             data.status in ['pending', 'responded', 'closed'];
    }

    function isValidApplication(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.parentId is string && isValidId(data.parentId) &&
             data.childName is string && data.childName.size() > 0 && data.childName.size() <= 100 &&
             data.status in ['submitted', 'under_review', 'interview_scheduled', 'waitlisted', 'accepted', 'rejected', 'enrolled'];
    }

    function isValidNotification(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidProgress(data) {
      return data.studentId is string && isValidId(data.studentId) &&
             data.schoolId is string && isValidId(data.schoolId) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000;
    }

    function isValidFee(data) {
      return data.studentId is string && isValidId(data.studentId) &&
             data.parentId is string && isValidId(data.parentId) &&
             data.schoolId is string && isValidId(data.schoolId) &&
             data.amount is number;
    }

    function isValidMessage(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.receiverId is string && isValidId(data.receiverId) &&
             data.subject is string && data.subject.size() <= 200 &&
             data.body is string && data.body.size() <= 5000;
    }

    function isValidWebsite(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             (data.headline == null || (data.headline is string && data.headline.size() <= 200)) &&
             (data.template == null || (data.template is string && data.template.size() <= 50));
    }

    function isValidNewsletter(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 50000;
    }

    function isValidCommunicationLog(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.content is string && data.content.size() <= 5000;
    }

    function isValidAuditLog(data) {
      return data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
             data.resourceType is string && data.resourceType.size() > 0 && data.resourceType.size() <= 100;
    }

    function isValidDiscussionTopic(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 10000 &&
             data.category is string && data.category.size() <= 100 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 200 &&
             data.authorRole is string && data.authorRole.size() <= 50;
    }

    function isValidDiscussionReply(data) {
      return data.topicId is string && isValidId(data.topicId) &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 200 &&
             data.authorRole is string && data.authorRole.size() <= 50;
    }

    function isValidTeacherOnboarding(data) {
      return data.schoolId is string && isValidId(data.schoolId) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.userUid is string && isValidId(data.userUid) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.qualifications is string && data.qualifications.size() <= 2000;
    }

    // --- Rules ---

    match /audit_logs/{logId} {
      allow read: if false;
      allow create: if isSignedIn() && isValidAuditLog(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    (incoming().role != 'SuperAdmin' || isSuperAdmin()); 
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (incoming().role != 'SuperAdmin' || isSuperAdmin()))
      );
    }

    match /schools/{schoolId} {
      allow get, list: if true;
      allow create: if isSuperAdmin() || (isVerified() && isValidId(schoolId) && isValidSchool(incoming()));
      allow update: if isSuperAdmin() || (isVerified() && existing().ownerId == request.auth.uid && 
                    isValidSchool(incoming()) &&
                    incoming().ownerId == existing().ownerId);
      allow delete: if isSuperAdmin() || (isVerified() && existing().ownerId == request.auth.uid);
    }

    match /educational_videos/{videoId} {
      allow read, get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /school_registrations/{regId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /dashboard_notes/{noteId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /live_classes/{classId} {
      allow read, get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /live_chats/{chatId} {
      allow read, get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(incoming()) && exists(/databases/$(database)/documents/schools/$(incoming().schoolId));
      allow get: if isSignedIn() && (resource.data.schoolId is string) && exists(/databases/$(database)/documents/schools/$(resource.data.schoolId)) && get(/databases/$(database)/documents/schools/$(resource.data.schoolId)).data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && (
        isSchoolOwner(resource.data.schoolId) ||
        resource.data.parentEmail == request.auth.token.email
      );
    }

    match /websites/{websiteId} {
      allow get: if true;
      allow create: if isVerified() && 
                    isSchoolOwner(incoming().schoolId) &&
                    isValidWebsite(incoming());
      allow update: if isVerified() && 
                    isSchoolOwner(existing().schoolId) &&
                    isValidWebsite(incoming()) &&
                    incoming().schoolId == existing().schoolId;
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && (isSchoolOwner(resource.data.schoolId) || resource.data.parentId == request.auth.uid);
      allow list: if isSignedIn() && (
        isSchoolOwner(resource.data.schoolId) || 
        resource.data.parentId == request.auth.uid || 
        resource.data.parentEmail == request.auth.token.email
      );
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidStudent(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidStudent(incoming()) && incoming().schoolId == existing().schoolId;
      allow delete: if isVerified() && isSchoolOwner(existing().schoolId);
    }

    match /staff/{staffId} {
      allow get: if isVerified() && isSchoolOwner(resource.data.schoolId);
      allow list: if isSignedIn() && isSchoolOwner(resource.data.schoolId);
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidStaff(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidStaff(incoming()) && incoming().schoolId == existing().schoolId;
      allow delete: if isVerified() && isSchoolOwner(existing().schoolId);
    }

    match /attendance/{attendanceId} {
      allow get: if isVerified() && isSchoolOwner(resource.data.schoolId);
      allow list: if isSignedIn() && (isSchoolOwner(resource.data.schoolId) || resource.data.parentId == request.auth.uid);
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidAttendance(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidAttendance(incoming()) && incoming().schoolId == existing().schoolId;
      allow delete: if isVerified() && isSchoolOwner(existing().schoolId);
    }

    match /events/{eventId} {
      allow get, list: if true;
      allow delete: if isVerified() && isSchoolOwner(existing().schoolId);
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidEvent(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidEvent(incoming()) && incoming().schoolId == existing().schoolId;
    }

    match /announcements/{announcementId} {
      allow get, list: if true;
      allow delete: if isVerified() && isSchoolOwner(existing().schoolId);
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidAnnouncement(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidAnnouncement(incoming()) && incoming().schoolId == existing().schoolId;
    }

    match /applications/{applicationId} {
      allow create: if isSignedIn() && isValidApplication(incoming()) && incoming().parentId == request.auth.uid;
      allow get, list: if isSignedIn() && (
        resource.data.parentId == request.auth.uid || 
        resource.data.parentEmail == request.auth.token.email ||
        isSchoolOwner(resource.data.schoolId)
      );
      allow update: if isSignedIn() && (
        (resource.data.parentId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['childName', 'medicalInfo', 'address'])) ||
        (isSchoolOwner(existing().schoolId) && isValidApplication(incoming()) && incoming().parentId == existing().parentId)
      );
      allow delete: if isSignedIn() && resource.data.parentId == request.auth.uid && resource.data.status == 'submitted';
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn() && isSchoolOwner(incoming().schoolId) && isValidNotification(incoming());
    }

    match /progress/{updateId} {
      allow get: if isSignedIn() && (isSchoolOwner(resource.data.schoolId) || (exists(/databases/$(database)/documents/students/$(resource.data.studentId)) && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.parentId == request.auth.uid));
      allow list: if isSignedIn() && (isSchoolOwner(resource.data.schoolId) || resource.data.parentId == request.auth.uid);
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidProgress(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidProgress(incoming());
    }

    match /fees/{feeId} {
      allow get, list: if isSignedIn() && (isSchoolOwner(resource.data.schoolId) || resource.data.parentId == request.auth.uid);
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidFee(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidFee(incoming());
    }

    match /messages/{messageId} {
      allow create: if isSignedIn() && isValidMessage(incoming()) && incoming().senderId == request.auth.uid;
      allow get, list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow update: if isSignedIn() && resource.data.receiverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    match /newsletters/{newsletterId} {
      allow get, list: if true;
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidNewsletter(incoming());
      allow update: if isVerified() && isSchoolOwner(existing().schoolId) && isValidNewsletter(incoming());
      allow delete: if isVerified() && isSchoolOwner(existing().schoolId);
    }

    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || (isSignedIn() && getRole() == 'Supplier' && existing().supplierId == request.auth.uid);
    }
    
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isSignedIn() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && isSchoolOwner(existing().schoolId);
    }
    
    match /student_progress/{progressId} {
      allow get, list: if isSignedIn() && (isSchoolOwner(resource.data.schoolId) || resource.data.parentId == request.auth.uid);
      allow create: if isSignedIn() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && isSchoolOwner(existing().schoolId);
    }
    
    match /learning_documents/{docId} {
      allow read: if true; /* shared resources could be public to the network */
      allow create: if isSignedIn() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && isSchoolOwner(existing().schoolId);
    }
    
    match /lessons/{lessonId} {
      allow read: if true;
      allow create: if isSignedIn() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && isSchoolOwner(existing().schoolId);
    }
    
    match /transport_routes/{routeId} {
      allow get, list: if isSignedIn() && isSchoolOwner(resource.data.schoolId);
      allow create: if isSignedIn() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && isSchoolOwner(existing().schoolId);
    }

    match /school_documents/{docId} {
      allow get, list: if isSignedIn() && isSchoolOwner(resource.data.schoolId);
      allow create: if isSignedIn() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && isSchoolOwner(existing().schoolId);
    }

    match /communication_logs/{logId} {
      allow get, list: if isSignedIn() && (isSchoolOwner(resource.data.schoolId) || resource.data.recipientIds.hasAny([request.auth.uid]));
      allow create: if isVerified() && isSchoolOwner(incoming().schoolId) && isValidCommunicationLog(incoming());
    }

    match /discussion_topics/{topicId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidDiscussionTopic(incoming());
      allow update: if isSignedIn() && (
        (existing().authorId == request.auth.uid && isValidDiscussionTopic(incoming())) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount'])) ||
        (incoming().diff(existing()).affectedKeys().hasAny(['repliesCount', 'likes'])) ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isSuperAdmin());
    }

    match /discussion_replies/{replyId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidDiscussionReply(incoming());
      allow update: if isSignedIn() && (
        (existing().authorId == request.auth.uid && isValidDiscussionReply(incoming())) ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isSuperAdmin());
    }

    match /teacher_onboardings/{onboardingId} {
      allow create: if isSignedIn() && isValidTeacherOnboarding(incoming()) && incoming().userUid == request.auth.uid;
      allow get, list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isSchoolOwner(resource.data.schoolId) || isSuperAdmin());
      allow update: if isSignedIn() && (
        (existing().userUid == request.auth.uid && existing().status == 'pending' && isValidTeacherOnboarding(incoming()) && incoming().userUid == request.auth.uid && incoming().status == 'pending' && incoming().schoolId == existing().schoolId) ||
        (isSchoolOwner(existing().schoolId) && isValidTeacherOnboarding(incoming()) && incoming().userUid == existing().userUid) ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (existing().userUid == request.auth.uid && existing().status == 'pending');
    }

    match /payment_configs/{configId} {
      allow get, list: if isSignedIn() && ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /crm_tasks/{taskId} {
      allow get, list: if isSignedIn() && ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /crm_automations/{autoId} {
      allow get, list: if isSignedIn() && ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /compliance_documents/{docId} {
      allow get, list: if isSignedIn() && (isSuperAdmin() || ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId)));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /critical_incidents/{incidentId} {
      allow get, list: if isSignedIn() && (('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId)) || ('parentId' in resource.data && resource.data.parentId == request.auth.uid));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /school_claims/{claimId} {
      allow get, list: if isSignedIn() && (isSuperAdmin() || ('claimedBy' in resource.data && resource.data.claimedBy == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /system_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /flatlet_applications/{appId} {
      allow get, list: if isSignedIn() && (isSuperAdmin() || ('parentId' in resource.data && resource.data.parentId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isSuperAdmin() || ('parentId' in resource.data && resource.data.parentId == request.auth.uid));
    }

    match /nanny_placement_requests/{reqId} {
      allow get, list: if isSignedIn() && (isSuperAdmin() || ('parentId' in resource.data && resource.data.parentId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isSuperAdmin() || ('parentId' in resource.data && resource.data.parentId == request.auth.uid));
    }

    match /payment_configs/{configId} {
      allow get, list: if isSignedIn() && ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /crm_tasks/{taskId} {
      allow get, list: if isSignedIn() && ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /crm_automations/{autoId} {
      allow get, list: if isSignedIn() && ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /compliance_documents/{docId} {
      allow get, list: if isSignedIn() && (isSuperAdmin() || ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId)));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /critical_incidents/{incidentId} {
      allow get, list: if isSignedIn() && (('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId)) || ('parentId' in resource.data && resource.data.parentId == request.auth.uid));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /daily_logs/{logId} {
      allow get, list: if isSignedIn() && (('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId)) || ('parentId' in resource.data && resource.data.parentId == request.auth.uid));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /weekly_dietary_reports/{reportId} {
      allow get, list: if isSignedIn() && ('schoolId' in resource.data && isSchoolOwner(resource.data.schoolId));
      allow create: if isSignedIn() && 'schoolId' in incoming() && isSchoolOwner(incoming().schoolId);
      allow update, delete: if isSignedIn() && 'schoolId' in existing() && isSchoolOwner(existing().schoolId);
    }

    match /sales_leads/{leadId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /agent_recommendations/{recommendationId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /agent_logs/{logId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /agent_states/{stateId} {
      allow get, list, create, update, delete: if isSignedIn();
    }
  }
}
