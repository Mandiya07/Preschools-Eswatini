rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---

    function isValidSchool(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.region is string && data.region.size() <= 50 &&
             data.town is string && data.town.size() <= 50 &&
             data.ownerId == request.auth.uid;
    }

    function isValidInquiry(data) {
      return data.schoolId is string && exists(/databases/$(database)/documents/schools/$(data.schoolId)) &&
             data.parentName is string && data.parentName.size() <= 100 &&
             data.parentEmail is string && data.parentEmail.size() <= 100 &&
             data.message is string && data.message.size() <= 1000;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             (data.role == 'parent' || !('role' in data)); // Prevent self-assignment of admin/owner roles
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['email', 'schoolId', 'subscriptionPlan']); // Limit what user can change
    }

    match /schools/{schoolId} {
      allow get: if true; // Public directory
      allow list: if true; 
      allow create: if isVerified() && isValidId(schoolId) && isValidSchool(incoming());
      allow update: if isVerified() && isOwner(existing().ownerId) && isValidSchool(incoming()) &&
                    incoming().ownerId == existing().ownerId; // ownerId is immutable
      allow delete: if isVerified() && isOwner(existing().ownerId);
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(incoming());
      allow get, list: if isSignedIn() && (
        get(/databases/$(database)/documents/schools/$(existing().schoolId)).data.ownerId == request.auth.uid
      );
    }

    match /websites/{websiteId} {
      allow get: if true; // Public school website
      allow create, update: if isVerified() && 
                             get(/databases/$(database)/documents/schools/$(incoming().schoolId)).data.ownerId == request.auth.uid;
      allow delete: if isVerified() && 
                             get(/databases/$(database)/documents/schools/$(existing().schoolId)).data.ownerId == request.auth.uid;
    }
  }
}
